<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gnacho.nextsync</id>
  <name>NextSync</name>
  <summary>Your files, local. Any server, in sync</summary>
  <developer id="io.github.gnacho">
    <name>gnacho</name>
  </developer>
  <launchable type="desktop-id">io.github.gnacho.nextsync.desktop</launchable>
  <url type="homepage">https://github.com/gnacho/nextsync</url>
  <url type="bugtracker">https://github.com/gnacho/nextsync/issues</url>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      NextSync is a GNOME-native desktop companion for keeping complete local
      mirrors of your Nextcloud accounts. It syncs with its own Rust engine,
      which speaks WebDAV directly, and adds the desktop integration: system
      tray, live folder status, conflict resolution and deletion review.
    </p>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#0082c8</color>
    <color type="primary" scheme_preference="dark">#4aa8d8</color>
  </branding>
